[Desktop Entry]
Type=Application
Name=Kea
GenericName=Voice Dictation
Comment=On-device, streaming voice dictation for KDE Plasma (Wayland)
Comment[pt]=Ditado por voz no dispositivo para o KDE Plasma
Exec=kea
Icon=audio-input-microphone
Categories=Utility;Accessibility;Qt;KDE;
Keywords=voice;dictation;speech;transcribe;ASR;whisper;parakeet;plasma;
Terminal=false
SingleMainWindow=true
StartupNotify=true
StartupWMClass=kea
X-KDE-StartupNotify=true
X-GNOME-UsesNotifications=false
# KWin blacklists org_kde_kwin_fake_input unless listed here (X-KDE-Wayland-Interfaces).
# Required for InsertionRouter step 2. Install this desktop file; Exec= must match
# the running binary (use installed `kea`, not only an uninstalled build tree path).
X-KDE-Wayland-Interfaces=org_kde_kwin_fake_input
